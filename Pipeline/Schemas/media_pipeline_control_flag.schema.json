{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediapipeline.local/schemas/media_pipeline_control_flag.schema.json",
  "title": "MediaPipeline operator control flag",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "action",
    "label",
    "request_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "pipeline_control_flag.v1"
    },
    "action": {
      "type": "string",
      "enum": [
        "pause",
        "stop",
        "rescan"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "app_pid": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
