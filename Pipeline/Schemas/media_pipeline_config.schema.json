{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mediapipeline/schemas/media_pipeline_config.v1.schema.json",
  "title": "MediaPipeline Remux Encode AIO Config",
  "type": "object",
  "x-config-schema-version": 1,
  "additionalProperties": true,
  "required": [
    "SourceMovies",
    "SourceTV",
    "Outsource",
    "LocalBase",
    "EncodeThresholdGB",
    "TVEncodeThresholdGB",
    "MinFreeSpaceGB",
    "VideoCodec",
    "VideoPreset",
    "VideoQuality",
    "OutputContainer",
    "CompatibleAudioCodecs",
    "SubKeepLanguages",
    "SubSDHTitleKeywords",
    "SubSupplementalKeywords",
    "DropAssAfterConversion",
    "RemuxSafeVideoCodecs",
    "ValidExtensions",
    "FileStabilityWait",
    "EnableIntegrityCheck",
    "CreateTVSubfolder",
    "RobocopyFlags",
    "DebugMode",
    "SkipStabilityCheck"
  ],
  "properties": {
    "ConfigSchemaVersion": { "type": "integer", "const": 1 },
    "SourceMovies": { "type": "string", "minLength": 1 },
    "SourceTV": { "type": "string", "minLength": 1 },
    "Outsource": { "type": "string", "minLength": 1 },
    "LibraryProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "designation": { "type": "string", "enum": [ "movie", "tv", "auto", "mixed", "custom" ] },
          "source_path": { "type": "string" },
          "output_path": { "type": "string" },
          "promotion_enabled": { "type": "boolean" },
          "promotion_destination": { "type": "string" },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "editor": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "RoutingProfile": {},
                  "RouteThresholdMode": {},
                  "SizeGuardMode": {},
                  "EncodeTuningPreset": {},
                  "EncodeLadder": {},
                  "VideoCodec": {},
                  "OutputContainer": {},
                  "EncodeThresholdGB": {},
                  "TVEncodeThresholdGB": {},
                  "MovieRouteMaxVideoBitrateMbps": {},
                  "TVRouteMaxVideoBitrateMbps": {},
                  "MaxEncodeGrowthPercent": {},
                  "CompatibilityEncodeGrowthPercent": {}
                }
              },
              "video": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "VideoPreset": {},
                  "VideoQuality": {},
                  "AllowH264RemuxIfPlexCompatible": {},
                  "H264RemuxMaxBitrateMbps": {},
                  "H264RemuxMaxHeight": {},
                  "RemuxSafeVideoCodecs": {},
                  "FallbackCpuQuality": {},
                  "CpuEncodePreset": {},
                  "CpuEncodeProcessPriority": {},
                  "CpuEncodeMaxThreads": {},
                  "ExtraVideoFlags": {}
                }
              },
              "subtitles": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "SubKeepLanguages": {},
                  "ConvertTx3gToSrt": {},
                  "DropTx3gAfterConversion": {},
                  "CreateExternalTx3gSrtSidecars": {},
                  "Tx3gExtractLanguages": {},
                  "Tx3gPreserveExistingSrt": {},
                  "Tx3gTreatForcedAsSeparate": {},
                  "ConvertBdpgsToSrt": {},
                  "DropBdpgsAfterConversion": {},
                  "BdpgsExtractLanguages": {},
                  "BdpgsOcrToolPath": {},
                  "BdpgsOcrTessdataPath": {},
                  "ConvertVobSubToSrt": {},
                  "DropVobSubAfterConversion": {},
                  "VobSubExtractLanguages": {},
                  "VobSubOcrToolPath": {},
                  "SubtitleExtractTimeoutSeconds": {},
                  "SubtitleProbeTimeoutSeconds": {},
                  "BdpgsOcrTimeoutSeconds": {},
                  "VobSubOcrTimeoutSeconds": {},
                  "SubSDHTitleKeywords": {},
                  "SubSupplementalKeywords": {},
                  "DropAssAfterConversion": {},
                  "StripFormatting": {},
                  "RemoveKaraoke": {},
                  "MergeAdjacent": {},
                  "MergeThresholdMs": {},
                  "KeepSignsAndSongs": {},
                  "TreatAssSignsSongsAsForced": {},
                  "TreatTx3gSignsSongsAsForced": {},
                  "TreatBdpgsSignsSongsAsForced": {},
                  "TreatVobSubSignsSongsAsForced": {},
                  "ExcludeSubtitleStyles": {},
                  "IncludeSubtitleStyles": {}
                }
              },
              "audio": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "AudioPassthroughProfile": {},
                  "CompatibleAudioCodecs": {},
                  "PreferredDefaultAudioLanguages": {},
                  "AudioTranscodeCodec": {},
                  "AudioTranscodeBitrate": {},
                  "AudioTranscodeAutoBitrateByChannels": {},
                  "AudioDownmixMode": {},
                  "AudioMaxChannels": {},
                  "AllowNoAudio": {}
                }
              }
            }
          },
          "editor_overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "RoutingProfile": {},
              "RouteThresholdMode": {},
              "SizeGuardMode": {},
              "EncodeTuningPreset": {},
              "EncodeLadder": {},
              "VideoCodec": {},
              "OutputContainer": {},
              "EncodeThresholdGB": {},
              "TVEncodeThresholdGB": {},
              "MovieRouteMaxVideoBitrateMbps": {},
              "TVRouteMaxVideoBitrateMbps": {},
              "MaxEncodeGrowthPercent": {},
              "CompatibilityEncodeGrowthPercent": {}
            }
          },
          "media_overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "VideoPreset": {},
              "VideoQuality": {},
              "AllowH264RemuxIfPlexCompatible": {},
              "H264RemuxMaxBitrateMbps": {},
              "H264RemuxMaxHeight": {},
              "RemuxSafeVideoCodecs": {},
              "FallbackCpuQuality": {},
              "CpuEncodePreset": {},
              "CpuEncodeProcessPriority": {},
              "CpuEncodeMaxThreads": {},
              "ExtraVideoFlags": {},
              "SubKeepLanguages": {},
              "ConvertTx3gToSrt": {},
              "DropTx3gAfterConversion": {},
              "CreateExternalTx3gSrtSidecars": {},
              "Tx3gExtractLanguages": {},
              "Tx3gPreserveExistingSrt": {},
              "Tx3gTreatForcedAsSeparate": {},
              "ConvertBdpgsToSrt": {},
              "DropBdpgsAfterConversion": {},
              "BdpgsExtractLanguages": {},
              "BdpgsOcrToolPath": {},
              "BdpgsOcrTessdataPath": {},
              "ConvertVobSubToSrt": {},
              "DropVobSubAfterConversion": {},
              "VobSubExtractLanguages": {},
              "VobSubOcrToolPath": {},
              "SubtitleExtractTimeoutSeconds": {},
              "SubtitleProbeTimeoutSeconds": {},
              "BdpgsOcrTimeoutSeconds": {},
              "VobSubOcrTimeoutSeconds": {},
              "SubSDHTitleKeywords": {},
              "SubSupplementalKeywords": {},
              "DropAssAfterConversion": {},
              "StripFormatting": {},
              "RemoveKaraoke": {},
              "MergeAdjacent": {},
              "MergeThresholdMs": {},
              "KeepSignsAndSongs": {},
              "TreatAssSignsSongsAsForced": {},
              "TreatTx3gSignsSongsAsForced": {},
              "TreatBdpgsSignsSongsAsForced": {},
              "TreatVobSubSignsSongsAsForced": {},
              "ExcludeSubtitleStyles": {},
              "IncludeSubtitleStyles": {},
              "AudioPassthroughProfile": {},
              "CompatibleAudioCodecs": {},
              "PreferredDefaultAudioLanguages": {},
              "AudioTranscodeCodec": {},
              "AudioTranscodeBitrate": {},
              "AudioTranscodeAutoBitrateByChannels": {},
              "AudioDownmixMode": {},
              "AudioMaxChannels": {},
              "AllowNoAudio": {}
            }
          },
          "default_tracking": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "LocalBase": { "type": "string", "minLength": 1 },
    "EncodeThresholdGB": { "type": "integer", "minimum": 1 },
    "TVEncodeThresholdGB": { "type": "integer", "minimum": 1 },
    "RoutingProfile": {
      "type": "string",
      "enum": [ "plex_direct_stream", "plex_direct_play", "archive_shrink", "archive_quality", "manual" ]
    },
    "RouteThresholdMode": {
      "type": "string",
      "enum": [ "compatibility_advisory", "size", "bitrate", "size_or_bitrate" ]
    },
    "MovieRouteMaxVideoBitrateMbps": { "type": "integer", "minimum": 1, "maximum": 500 },
    "TVRouteMaxVideoBitrateMbps": { "type": "integer", "minimum": 1, "maximum": 500 },
    "AllowH264RemuxIfPlexCompatible": { "type": "boolean" },
    "H264RemuxMaxBitrateMbps": { "type": "integer", "minimum": 1, "maximum": 500 },
    "H264RemuxMaxHeight": { "type": "integer", "minimum": 1, "maximum": 4320 },
    "SizeGuardMode": {
      "type": "string",
      "enum": [ "advisory", "strict", "off" ]
    },
    "MaxEncodeGrowthPercent": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "CompatibilityEncodeGrowthPercent": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "MinFreeSpaceGB": { "type": "integer", "minimum": 0 },
    "OutsourceMinFreeSpaceGB": { "type": "integer", "minimum": 0 },
    "DeferredPublish": { "type": "boolean" },
    "FinalLibraryPromotionEnabled": { "type": "boolean" },
    "FinalLibraryPromotionRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "enabled": { "type": "boolean" },
          "source_root": { "type": "string" },
          "output_root": { "type": "string" },
          "destination_root": { "type": "string" },
          "library_id": { "type": "string" },
          "designation": { "type": "string" }
        }
      }
    },
    "FinalLibraryPromotionVerificationMode": {
      "type": "string",
      "enum": [ "fast", "cautious" ]
    },
    "FinalLibraryPromotionCleanupAfterVerified": { "type": "boolean" },
    "FinalLibraryPromotionOverwriteExisting": { "type": "boolean" },
    "VideoCodec": { "type": "string", "enum": [ "hevc_nvenc", "libx265", "h264_nvenc", "libx264", "av1_nvenc" ] },
    "VideoPreset": { "type": "string", "enum": [ "p1", "p2", "p3", "p4", "p5", "p6", "p7" ] },
    "VideoQuality": { "type": "integer", "minimum": 1, "maximum": 51 },
    "OutputContainer": { "type": "string", "enum": [ "mkv", "mp4" ] },
    "EncodeTuningPreset": {
      "type": "string",
      "enum": [ "balanced_nvenc", "quality_nvenc", "fast_nvenc", "compatibility", "custom_legacy_flags" ]
    },
    "EncodeLadder": {
      "type": "string",
      "enum": [ "auto", "tv_balanced", "tv_space_saver", "movie_balanced", "movie_archive", "plex_compat" ]
    },
    "ExtraVideoFlags": { "type": "array", "items": { "type": "string" } },
    "AudioPassthroughProfile": {
      "type": "string",
      "enum": [ "plex_balanced", "compatibility", "lossless_passthrough", "custom_codec_list" ]
    },
    "CompatibleAudioCodecs": { "type": "array", "items": { "type": "string" } },
    "PreferredDefaultAudioLanguages": { "type": "array", "items": { "type": "string" } },
    "AudioTranscodeCodec": { "type": "string", "enum": [ "eac3", "ac3", "aac" ] },
    "AudioTranscodeBitrate": { "type": "string", "pattern": "^\\d+k$" },
    "AudioDownmixMode": { "type": "string", "enum": [ "preserve", "max_channels", "stereo" ] },
    "AudioMaxChannels": { "type": "integer", "minimum": 1, "maximum": 16 },
    "AllowNoAudio": { "type": "boolean" },
    "SubKeepLanguages": { "type": "array", "items": { "type": "string" } },
    "ConvertTx3gToSrt": { "type": "boolean" },
    "DropTx3gAfterConversion": { "type": "boolean" },
    "CreateExternalTx3gSrtSidecars": { "type": "boolean" },
    "Tx3gExtractLanguages": { "type": "array", "items": { "type": "string" } },
    "Tx3gPreserveExistingSrt": { "type": "boolean" },
    "Tx3gTreatForcedAsSeparate": { "type": "boolean" },
    "ConvertBdpgsToSrt": { "type": "boolean" },
    "DropBdpgsAfterConversion": { "type": "boolean" },
    "BdpgsExtractLanguages": { "type": "array", "items": { "type": "string" } },
    "BdpgsOcrToolPath": { "type": "string" },
    "BdpgsOcrTessdataPath": { "type": "string" },
    "ConvertVobSubToSrt": { "type": "boolean" },
    "DropVobSubAfterConversion": { "type": "boolean" },
    "VobSubExtractLanguages": { "type": "array", "items": { "type": "string" } },
    "VobSubOcrToolPath": { "type": "string" },
    "SubSDHTitleKeywords": { "type": "array", "items": { "type": "string" } },
    "SubSupplementalKeywords": { "type": "array", "items": { "type": "string" } },
    "DropAssAfterConversion": { "type": "boolean" },
    "StripFormatting": { "type": "boolean" },
    "RemoveKaraoke": { "type": "boolean" },
    "MergeAdjacent": { "type": "boolean" },
    "MergeThresholdMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
    "KeepSignsAndSongs": { "type": "boolean" },
    "TreatAssSignsSongsAsForced": { "type": "boolean" },
    "TreatTx3gSignsSongsAsForced": { "type": "boolean" },
    "TreatBdpgsSignsSongsAsForced": { "type": "boolean" },
    "TreatVobSubSignsSongsAsForced": { "type": "boolean" },
    "ExcludeSubtitleStyles": { "type": "array", "items": { "type": "string" } },
    "IncludeSubtitleStyles": { "type": "array", "items": { "type": "string" } },
    "RemuxSafeVideoCodecs": { "type": "array", "items": { "type": "string" } },
    "ValidExtensions": { "type": "array", "items": { "type": "string" } },
    "FileStabilityWait": { "type": "integer", "minimum": 0 },
    "SkipStabilityCheck": { "type": "boolean" },
    "EnableIntegrityCheck": { "type": "boolean" },
    "CreateTVSubfolder": { "type": "boolean" },
    "AggressiveEpisodeParsing": { "type": "boolean" },
    "RobocopyFlags": { "type": "array", "items": { "type": "string" } },
    "DebugMode": { "type": "boolean" },
    "LogRetentionDays": { "type": "integer", "minimum": 0 },
    "PriorityMarkers": { "type": "array", "items": { "type": "string" } },
    "MixPriorityPhase": { "type": "boolean" },
    "QueueOrderingStrategy": { "type": "string" },
    "ConsoleLogLevel": { "type": "string" },
    "FileLogLevel": { "type": "string" },
    "MaxParallelEncodes": { "type": "integer", "minimum": 1, "maximum": 2 },
    "ParallelEncodeMode": { "type": "string", "enum": [ "single", "local_worker_slots" ] },
    "FallbackCpuQuality": { "type": [ "integer", "null" ], "minimum": 1, "maximum": 51 },
    "CpuEncodePreset": {
      "type": "string",
      "enum": [ "ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow", "placebo" ]
    },
    "CpuEncodeProcessPriority": {
      "type": "string",
      "enum": [ "inherit", "idle", "belownormal", "normal", "abovenormal", "high" ]
    },
    "CpuEncodeMaxThreads": { "type": "integer", "minimum": 0, "maximum": 256 },
    "OutputSizeMultiplier": { "type": [ "number", "null" ], "minimum": 0.1, "maximum": 2.0 },
    "FFmpegEncodeTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "FFmpegCpuEncodeTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "FFmpegRemuxTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "MkvmergeRemuxTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "AudioTranscodeAutoBitrateByChannels": { "type": "boolean" },
    "SubtitleExtractTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
    "SubtitleProbeTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 600 },
    "BdpgsOcrTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 14400 },
    "VobSubOcrTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 14400 },
    "OutputValidationProbeTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "OutputValidationMinSizeBytes": { "type": "integer", "minimum": 0 },
    "OutputValidationDurationToleranceSeconds": { "type": "integer", "minimum": 0 },
    "AllowSystemTools": { "type": "boolean" },
    "RobocopyTimeoutSeconds": { "type": "integer", "minimum": 60, "maximum": 172800 },
    "TransientFailureRetryLimit": { "type": "integer", "minimum": 1, "maximum": 100 },
    "IndexScanTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "SourceScanTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "CleanupScanTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 7200 },
    "CleanupRemoteStaging": { "type": "boolean" },
    "CleanupStaleAgeHours": { "type": "integer", "minimum": 1, "maximum": 720 },
    "SourceScanIntervalSeconds": { "type": "integer", "minimum": 0 },
    "ProcessedIndexRefreshSeconds": { "type": "integer", "minimum": 0 },
    "MinPipelineVersion": { "type": "string" },
    "ReprocessAll": { "type": "boolean" },
    "ShowOverrides": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": {
        "required": [ "ConvertTx3gToSrt" ],
        "properties": { "ConvertTx3gToSrt": { "const": false } }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [ "DropTx3gAfterConversion" ],
              "properties": { "DropTx3gAfterConversion": { "const": true } }
            },
            {
              "required": [ "CreateExternalTx3gSrtSidecars" ],
              "properties": { "CreateExternalTx3gSrtSidecars": { "const": true } }
            }
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          { "not": { "required": [ "ConvertBdpgsToSrt" ] } },
          {
            "required": [ "ConvertBdpgsToSrt" ],
            "properties": { "ConvertBdpgsToSrt": { "const": false } }
          }
        ]
      },
      "then": {
        "not": {
          "required": [ "DropBdpgsAfterConversion" ],
          "properties": { "DropBdpgsAfterConversion": { "const": true } }
        }
      }
    },
    {
      "if": {
        "required": [ "ConvertBdpgsToSrt" ],
        "properties": { "ConvertBdpgsToSrt": { "const": true } }
      },
      "then": {
        "not": {
          "required": [ "BdpgsOcrToolPath" ],
          "properties": { "BdpgsOcrToolPath": { "type": "string", "pattern": "^\\s*$" } }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          { "not": { "required": [ "ConvertVobSubToSrt" ] } },
          {
            "required": [ "ConvertVobSubToSrt" ],
            "properties": { "ConvertVobSubToSrt": { "const": false } }
          }
        ]
      },
      "then": {
        "not": {
          "required": [ "DropVobSubAfterConversion" ],
          "properties": { "DropVobSubAfterConversion": { "const": true } }
        }
      }
    },
    {
      "if": {
        "required": [ "ConvertVobSubToSrt" ],
        "properties": { "ConvertVobSubToSrt": { "const": true } }
      },
      "then": {
        "not": {
          "required": [ "VobSubOcrToolPath" ],
          "properties": { "VobSubOcrToolPath": { "type": "string", "pattern": "^\\s*$" } }
        }
      }
    }
  ]
}
