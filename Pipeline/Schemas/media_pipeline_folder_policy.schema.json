{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mediapipeline/schemas/media_pipeline_folder_policy.v1.schema.json",
  "title": "MediaPipeline Folder Policy Sidecar",
  "type": "object",
  "additionalProperties": true,
  "required": [ "schema_version", "audio", "subtitles", "validation" ],
  "properties": {
    "schema_version": { "type": "string", "const": "folder_policy.v1" },
    "folder": { "type": "string" },
    "audio": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "passthrough_profile": { "type": "string", "enum": [ "", "plex_balanced", "compatibility", "lossless_passthrough", "custom_codec_list" ] },
        "passthrough_codecs": { "type": "array", "items": { "type": "string" } },
        "preferred_default_languages": { "type": "array", "items": { "type": "string" } },
        "transcode_codec": { "type": "string", "enum": [ "", "eac3", "ac3", "aac" ] },
        "transcode_bitrate": { "type": "string", "pattern": "^(|[1-9]\\d*k)$" },
        "downmix_mode": { "type": "string", "enum": [ "", "preserve", "max_channels", "stereo" ] },
        "max_channels": { "type": [ "integer", "null" ], "minimum": 1, "maximum": 16 }
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "ass": { "$ref": "#/$defs/subtitlePolicy" },
        "tx3g": { "$ref": "#/$defs/subtitlePolicy" },
        "bdpgs": { "$ref": "#/$defs/subtitlePolicy" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "routing_profile": { "type": "string", "enum": [ "", "plex_direct_stream", "plex_direct_play", "archive_shrink", "archive_quality", "manual" ] },
        "size_guard_mode": { "type": "string", "enum": [ "", "advisory", "strict", "off" ] },
        "allow_h264_remux_if_plex_compatible": { "type": [ "boolean", "null" ] },
        "h264_remux_max_bitrate_mbps": { "type": [ "number", "null" ], "exclusiveMinimum": 0 },
        "h264_remux_max_height": { "type": [ "integer", "null" ], "minimum": 1 },
        "force_route": { "type": "string", "enum": [ "", "auto", "remux", "encode" ] },
        "prefer_route": { "type": "string", "enum": [ "", "auto", "remux", "encode" ] },
        "max_video_bitrate_mbps": { "type": [ "number", "null" ], "exclusiveMinimum": 0 },
        "max_resolution_height": { "type": [ "integer", "null" ], "minimum": 1 },
        "allowed_video_codecs": { "type": "array", "items": { "type": "string" } },
        "plex_strict_mode": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sample_file": { "type": "string" },
        "require_uniform_stream_topology": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "subtitlePolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "drop_after_conversion": { "type": "boolean" }
      }
    }
  }
}
