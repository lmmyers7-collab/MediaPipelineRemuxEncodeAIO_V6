{
  "schema_version": "risky_file_registry.v1",
  "entries": [
    {
      "id": "source_scratch_output_movement",
      "path_globs": [
        "ops/pipeline/engine/storage/**",
        "ops/pipeline/engine/paths/**",
        "ops/pipeline/engine/shared/path_helpers.ps1",
        "ops/pipeline/engine/shared/temp_cleanup.ps1",
        "ops/pipeline/engine/process/pipeline_plan_executor.ps1",
        "ops/pipeline/engine/process/pipeline_plan_executor/**",
        "ops/pipeline/engine/process/pipeline_processing.ps1",
        "ops/pipeline/engine/process/pipeline_processing/**"
      ],
      "risk_level": "critical",
      "risk_domains": [
        "source_preservation",
        "scratch_copy",
        "path_safety",
        "cleanup"
      ],
      "validation_rung": "media-policy-release-real-media",
      "required_checks": [
        "ops/pipeline/tests/Unit/Invoke-PathBoundaryGuardChecks.ps1",
        "ops/pipeline/tests/Invoke-ReliabilityRegressionChecks.ps1",
        "python -m mediapipeline.tools.dev.refresh_summaries --check",
        "python -m mediapipeline.tools.dev.generate_project_index --check"
      ],
      "manual_gates": [
        "real-media validation when behavior changes source/scratch/output movement",
        "extra review for any source delete or overwrite permission change"
      ],
      "owner_docs": [
        "AGENTS.md",
        "docs/operator/NO_TOUCH_BOUNDARY_REGISTER.md",
        "docs/testing/VALIDATION_LADDER_RUNBOOK.md"
      ],
      "rationale": "These files control copy, move, cleanup, and path containment around source, scratch, and output media."
    },
    {
      "id": "publish_and_pending_publish",
      "path_globs": [
        "src/mediapipeline/core/publish/**",
        "ops/pipeline/engine/publish/**"
      ],
      "risk_level": "critical",
      "risk_domains": [
        "publish",
        "pending_publish",
        "source_preservation",
        "sidecar_carry_forward"
      ],
      "validation_rung": "settings-pending-publish-diagnostics",
      "required_checks": [
        "tests.python.desktop.test_application_facade_pending_publish",
        "tests.python.desktop.test_service_pending_publish_manifest",
        "ops/pipeline/tests/Unit/Invoke-PendingPublishSafetyChecks.ps1",
        "python -m mediapipeline.tools.dev.generate_lifecycle_map --check"
      ],
      "manual_gates": [
        "real-media validation when final publish, drain, or sidecar behavior changes",
        "extra review for any bypass of park/drain manifest evidence"
      ],
      "owner_docs": [
        "AGENTS.md",
        "docs/operator/NO_TOUCH_BOUNDARY_REGISTER.md",
        "docs/architecture/REPAIR_RECONCILE_MUTATION_CONTRACT.md"
      ],
      "rationale": "Pending publish protects final-root safety and must preserve evidence before any drain or cleanup."
    },
    {
      "id": "rename_apply",
      "path_globs": [
        "src/mediapipeline/core/rename/**"
      ],
      "risk_level": "high",
      "risk_domains": [
        "rename",
        "path_safety",
        "overwrite_prevention",
        "undo_manifest"
      ],
      "validation_rung": "targeted-route-tests-plus-smokes",
      "required_checks": [
        "tests.python.desktop.test_service_rename_apply",
        "tests.python.desktop.test_service_rename_planner",
        "tests.python.desktop.test_application_facade_rename"
      ],
      "manual_gates": [
        "extra review for any change that permits overwrite or cross-root rename"
      ],
      "owner_docs": [
        "AGENTS.md",
        "docs/operator/NO_TOUCH_BOUNDARY_REGISTER.md"
      ],
      "rationale": "Rename apply mutates media filenames and sidecars and relies on collision checks plus undo manifests."
    },
    {
      "id": "settings_and_config",
      "path_globs": [
        "src/mediapipeline/desktop/config*.py",
        "src/mediapipeline/contracts/config.py",
        "ops/pipeline/engine/config/**",
        "ops/pipeline/config/MediaPipeline_config_template.psd1",
        "ops/pipeline/config/profiles/*.psd1",
        "ops/pipeline/config/schemas/media_pipeline_config.schema.json",
        "src/mediapipeline/core/config/**",
        "src/mediapipeline/contracts/schemas/config.v1.schema.json"
      ],
      "risk_level": "high",
      "risk_domains": [
        "settings",
        "path_roots",
        "operator_policy"
      ],
      "validation_rung": "settings-queue-rename-pending-diagnostics",
      "required_checks": [
        "tests.python.core.contract.test_config_contract",
        "tests.python.desktop.test_config_service",
        "python -m mediapipeline.tools.dev.generate_config_schema --check"
      ],
      "manual_gates": [
        "extra review for defaults that affect safe delete, cleanup, roots, publish, audio, or subtitle policy"
      ],
      "owner_docs": [
        "AGENTS.md",
        "docs/operator/NO_TOUCH_BOUNDARY_REGISTER.md",
        "docs/testing/TEST_COVERAGE_MATRIX.md"
      ],
      "rationale": "Config controls roots, cleanup, publish policy, and operator-facing safety defaults."
    },
    {
      "id": "queue_and_process_control",
      "path_globs": [
        "src/mediapipeline/core/orchestration/**",
        "src/mediapipeline/core/processes/**",
        "src/mediapipeline/core/queue/**",
        "ops/pipeline/engine/process/**",
        "ops/pipeline/engine/queue/**"
      ],
      "risk_level": "high",
      "risk_domains": [
        "queue",
        "duplicate_processing",
        "process_control",
        "command_journal"
      ],
      "validation_rung": "targeted-route-tests-plus-smokes",
      "required_checks": [
        "tests.python.desktop.test_application_facade_queue",
        "tests.python.desktop.test_service_queue_dry_run",
        "tests.python.desktop.test_application_facade_process_launch"
      ],
      "manual_gates": [
        "extra review for changes to duplicate command guards, close readiness, or launch scope"
      ],
      "owner_docs": [
        "AGENTS.md",
        "docs/operator/NO_TOUCH_BOUNDARY_REGISTER.md",
        "docs/architecture/LOCAL_API_EVIDENCE_MUTATION_MATRIX.md"
      ],
      "rationale": "Queue and process controls decide when pipeline work starts and how duplicate work is prevented."
    },
    {
      "id": "ai_guardrails_and_generated_context",
      "path_globs": [
        "AGENTS.md",
        "docs/architecture/ARCHITECTURE.md",
        "docs/CURRENT_PROJECT_STATE.md",
        "docs/OPEN_WORK_CHECKLIST.md",
        "src/mediapipeline/tools/dev/refresh_summaries.py",
        "src/mediapipeline/tools/dev/generate_project_index.py",
        "src/mediapipeline/tools/dev/generate_pipeline_map.py",
        "src/mediapipeline/tools/dev/generate_lifecycle_map.py",
        "src/mediapipeline/tools/dev/check_architecture_guardrails.py",
        "src/mediapipeline/tools/dev/check_active_doc_references.py",
        "src/mediapipeline/tools/dev/check_dependency_boundaries.py",
        "src/mediapipeline/tools/dev/check_godfiles.py",
        "src/mediapipeline/tools/dev/check_marketecture.py",
        "src/mediapipeline/tools/dev/check_risky_file_registry.py",
        "src/mediapipeline/tools/dev/ai_guardrail.py",
        "src/mediapipeline/tools/lint_naming.py",
        "docs/inventories/GOD_FILE_GUARDRAIL.v1.json",
        "docs/inventories/RISKY_FILE_REGISTRY.v1.json",
        "docs/generated/PROJECT_INDEX.md",
        "docs/generated/DEPENDENCY_GRAPH.md",
        "docs/generated/PIPELINE_MAP.md",
        "docs/generated/FEATURE_FILE_MAP.md",
        "docs/generated/summaries/**/*.md"
      ],
      "risk_level": "high",
      "risk_domains": [
        "ai_development_guardrails",
        "generated_context",
        "architecture_lint"
      ],
      "validation_rung": "tooling-contract-tests",
      "required_checks": [
        "tests.python.tooling.test_summary_integrity",
        "tests.python.tooling.test_risky_file_registry",
        "tests.python.tooling.test_lifecycle_map",
        "tests.python.tooling.test_ai_guardrail",
        "python -m mediapipeline.tools.dev.refresh_summaries --check",
        "python -m mediapipeline.tools.dev.generate_project_index --check",
        "python -m mediapipeline.tools.dev.generate_lifecycle_map --check",
        "python -m mediapipeline.tools.dev.check_architecture_guardrails",
        "python -m mediapipeline.tools.lint_naming"
      ],
      "manual_gates": [
        "extra review before weakening AI entry-point or architecture guardrail rules"
      ],
      "owner_docs": [
        "AGENTS.md",
        "docs/architecture/ARCHITECTURE.md",
        "docs/CURRENT_PROJECT_STATE.md"
      ],
      "rationale": "These files shape what AI agents read, how they navigate the repo, and which architecture violations are caught."
    },
    {
      "id": "lifecycle_contract_and_docs",
      "path_globs": [
        "src/mediapipeline/contracts/lifecycle.py",
        "docs/architecture/FILE_LIFECYCLE_MAP.md",
        "docs/inventories/RUNTIME_ARTIFACT_INVENTORY.md",
        "docs/inventories/STATE_FILE_SCHEMA_REFERENCE.md"
      ],
      "risk_level": "medium",
      "risk_domains": [
        "lifecycle_docs",
        "state_machine",
        "recovery"
      ],
      "validation_rung": "docs-and-contract-checks",
      "required_checks": [
        "tests.python.tooling.test_lifecycle_map",
        "python -m mediapipeline.tools.dev.generate_lifecycle_map --check"
      ],
      "manual_gates": [
        "extra review if lifecycle map contradicts runtime behavior"
      ],
      "owner_docs": [
        "docs/inventories/RUNTIME_ARTIFACT_INVENTORY.md",
        "docs/inventories/STATE_FILE_SCHEMA_REFERENCE.md",
        "docs/operator/NO_TOUCH_BOUNDARY_REGISTER.md"
      ],
      "rationale": "Lifecycle documentation prevents AI and operators from losing track of state, cleanup, and recovery rules."
    }
  ]
}
