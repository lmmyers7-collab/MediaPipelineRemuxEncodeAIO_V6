{
  "schema_version": "marketecture_guardrail.v1",
  "description": "Flags marketing buzzwords (marketecture) in docs and source so project language stays concrete. Only clear marketing fluff is listed; ambiguous technical words (robust, leverage, scalable, performant, first-class, holistic) are deliberately excluded to avoid false positives. Suppress a justified single line with the inline marker 'allow-marketecture'.",
  "suppression_marker": "allow-marketecture",
  "include_globs": [
    "**/*.md",
    "**/*.py",
    "**/*.ps1",
    "**/*.psm1",
    "**/*.js",
    "**/*.mjs",
    "**/*.rs"
  ],
  "exclude_globs": [
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/Runtime/**",
    "**/target/**",
    "Docs/archive/**",
    "LocalBase/**",
    "V5/**",
    "Docs/inventories/MARKETECTURE_GUARDRAIL.v1.json",
    "scripts/dev/check_marketecture.py",
    "DesktopApp/tests/test_marketecture_guard.py"
  ],
  "terms": [
    "world-class",
    "best-in-class",
    "best-of-breed",
    "cutting-edge",
    "bleeding-edge",
    "state-of-the-art",
    "next-generation",
    "next-gen",
    "game-changer",
    "game-changing",
    "revolutionary",
    "paradigm shift",
    "synergy",
    "synergies",
    "turnkey",
    "supercharge",
    "supercharged",
    "frictionless",
    "rock-solid",
    "battle-tested",
    "enterprise-grade",
    "military-grade",
    "future-proof",
    "secret sauce",
    "unparalleled",
    "blazing-fast",
    "blazing fast",
    "lightning-fast",
    "one-stop shop",
    "hyper-scale",
    "web-scale"
  ]
}
