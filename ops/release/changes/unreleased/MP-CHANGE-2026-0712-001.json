{
  "id": "MP-CHANGE-2026-0712-001",
  "title": "Stabilize generated context across line endings",
  "version_target": "2026.06.04.001",
  "status": "complete",
  "type": "tooling",
  "risk_level": "medium",
  "date_started": "2026-07-12",
  "date_completed": "2026-07-12",
  "summary": "Normalize generated-context fingerprints, parsing, comparisons, and file writes across LF and CRLF checkouts, add regression coverage, and regenerate affected context through canonical tooling.",
  "reason": "Windows working-tree line endings and committed/CI line endings could represent identical text differently, causing 2,220 stale summaries and a stale WebView map on GitHub Actions even when local checks passed.",
  "affected_areas": [
    "ci",
    "generated-context",
    "generated_context",
    "webview-tooling",
    "webview_tooling"
  ],
  "behavior_before": "Summary SHA-256 values hashed raw line endings and the WebView analyzer parsed and compared raw line endings, so logically identical Windows and CI checkouts produced different freshness results.",
  "behavior_after": "Both generators normalize text line endings before hashing, parsing, or report comparison; LF-only archive simulation and the local checkout now produce the same freshness result.",
