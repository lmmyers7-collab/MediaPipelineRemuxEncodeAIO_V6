{
  "id": "MP-CHANGE-2026-0630-002",
  "title": "Add failure artifact cleanup policy",
  "version_target": "2026.06.04.001",
  "status": "complete",
  "type": "feature",
  "risk_level": "high",
  "date_started": "2026-06-30",
  "date_completed": "2026-06-30",
  "summary": "Added configurable failure artifact cleanup with dry-run planning, fingerprinted confirmation, backend-owned deletion, UI controls, settings, route contracts, inventories, and validation coverage.",
  "reason": "Failure artifact folders can grow into hundreds of gigabytes. Operators need a configurable, evidence-preserving way to delete old or excess failure artifacts without touching source media, output media, markers, reports, completed manifests, or pending-publish state.",
  "affected_areas": [
    "config",
    "contracts",
    "core",
    "docs",
    "generated",
    "local-api",
    "settings",
    "tauri",
    "tests",
    "tooling",
    "webview"
  ],
  "behavior_before": "Failure artifact storage was visible and warning-capable, but cleanup was visibility-only and no backend route could delete artifact files.",
  "behavior_after": "Failure artifact cleanup can be configured by retention days and/or target storage size. Cleanup is disabled by default, preview-first, requires a matching dry-run fingerprint plus reason and confirmation, deletes only files under backend-resolved failure artifact roots, and writes a deletion manifest.",
