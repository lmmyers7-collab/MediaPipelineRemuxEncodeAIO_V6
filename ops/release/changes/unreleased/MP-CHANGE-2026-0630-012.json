{
  "id": "MP-CHANGE-2026-0630-012",
  "title": "30 day unattended reliability hardening",
  "version_target": "2026.06.04.001",
  "status": "complete",
  "type": "behavior_change",
  "risk_level": "high",
  "date_started": "2026-06-30",
  "date_completed": "2026-07-01",
  "summary": "Hardened unattended operation with per-file and per-round exception containment, native no-progress aborts, bounded CPU mutex waits, local worker child hard timeouts, queued worker done-report recovery, worker_state backup/quarantine, bounded watch scans, progress persistence health, ActiveJobs full blocking scans, SQLite mirror maintenance, pending-publish health/batching, and long-run reliability counters in status/autonomy health payloads.",
  "reason": "A 30-day unattended run needs failures to become visible evidence, safe recovery to resume where possible, and long-running subprocess or state paths to avoid indefinite hangs without weakening source, scratch, subtitle, pending-publish, confirmation, or backend-ownership guardrails.",
  "affected_areas": [
    "backend",
    "powershell",
    "reliability",
    "state",
    "tests"
  ],
  "behavior_before": "Unexpected queue/round exceptions, native subprocess no-output hangs, CPU mutex waits, worker done-report persistence, corrupt worker state, watch scans, stale ActiveJobs, SQLite mirror growth, and pending-publish backlog health had weaker boundedness or less operator-visible evidence.",
  "behavior_after": "The pipeline records structured failure evidence, continues continuous mode with bounded backoff where safe, fails terminal single-pass paths, aborts native no-progress hangs, bounds CPU mutex and worker child waits, preserves queued worker reports, quarantines unrecoverable state, marks degraded watch scans, exposes state/write health, and keeps pending publish manual with stronger backlog evidence and normal retry batching.",
