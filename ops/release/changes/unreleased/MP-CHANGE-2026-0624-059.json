  "title": "Bind settings save review confirmation",
  "version_target": "2026.06.04.001",
  "status": "complete",
  "type": "bugfix",
  "risk_level": "medium",
  "date_started": "2026-06-24",
  "date_completed": "2026-06-25",
  "summary": "Bind settings save writes to the backend-confirmed review preview, add reload verification evidence, and cover LibraryProfiles saves with targeted unit, WebView, and browser smokes.",
  "reason": "LibraryProfiles settings changes could be reviewed in the UI and still fail to persist reliably because the save request was not cryptographically tied to the reviewed backend candidate and reload evidence did not prove the changed keys were present after save.",
  "affected_areas": [
    "settings"
  ],
  "behavior_before": "A confirmed settings save could submit changes without carrying a backend preview confirmation token, and the operator-facing save result did not include changed-key reload verification evidence.",
  "behavior_after": "Settings save writes require a matching review_confirmation token derived from the current backend preview candidate, internal backend save callers generate the same confirmation, WebView save flows post it explicitly, and save results report reload verification digests for changed keys.",
