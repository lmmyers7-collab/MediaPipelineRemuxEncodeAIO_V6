    "backend",
    "config",
    "docs",
    "generated-context",
    "tests",
    "webview"
  ],
  "behavior_before": "Failure artifact files could accumulate under current or legacy artifact roots without a dedicated API read model, Home/Reports visibility, or configurable storage warning.",
  "behavior_after": "The backend reports current and legacy failure artifact size, count, age, largest files, threshold state, and scan errors through a read-only authenticated route. Home and Reports show the summary, Settings exposes the threshold, and the WebView shows a once-per-session warning toast when the threshold is met.",
