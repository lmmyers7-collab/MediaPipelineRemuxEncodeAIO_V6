  "title": "Simplify Settings save review flow",
  "version_target": "2026.06.04.001",
  "status": "complete",
  "type": "behavior_change",
  "risk_level": "medium",
  "date_started": "2026-06-19",
  "date_completed": "2026-06-19",
  "summary": "Collapse Settings patch staging and preview controls into a direct Save Settings flow with an in-app change review dialog.",
  "reason": "The operator found the explicit Stage, Preview Patch, and browser-native confirmation flow confusing and hard to scan. Save should gather current builder values, show what will change in a readable review surface, and then persist only after confirmation.",
  "affected_areas": [
    "launch",
    "rename",
    "settings",
    "tauri",
    "tests",
    "webview"
  ],
  "behavior_before": "Rename cleaning filters had a separate Stage button, Settings exposed Preview Patch buttons, and Save used a browser confirm dialog with dense overwrite text and stale-preview wording.",
  "behavior_after": "Settings exposes Save Settings as the primary action, automatically merges current rename filter controls, avoids stale-status wording, and shows a dedicated review dialog with old/new values before backend save.",
