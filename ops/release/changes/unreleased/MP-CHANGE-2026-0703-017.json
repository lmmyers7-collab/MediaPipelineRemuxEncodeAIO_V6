  "summary": "Adds the backend-owned CSV rerun auto-return destination mode that replaces clean rerun outputs through the existing final replacement path and routes issue-bearing outputs to Pending Publish review with manifest evidence.",
  "reason": "CSV rerun is an audit-remediation workflow and needs a safe default that returns clean outputs to the backend-derived final/library target without making rerun rows normal pipeline queue rows or moving replacement decisions into the frontend.",
  "affected_areas": [
    "backend",
    "docs",
    "generated_context",
    "powershell",
    "tests",
    "webview"
  ],
  "behavior_before": "CSV rerun defaulted to review-workspace style behavior and replacement-capable launches were not represented by an explicit clean-replace-else-pending-review destination policy.",
  "behavior_after": "CSV rerun defaults to auto_replace_clean_else_pending_review with collision_policy=replace_final, requires strict confirm_replace_final for live replacement-capable starts, keeps source originals untouched, replaces only backend-verified clean outputs, and parks outputs with remaining issue evidence in Pending Publish review.",
