  "summary": "Harden pending-publish manifests so current manifest evidence, path roots, payload/sidecar location, output destination, and source identity must be trusted before repair or drain.",
  "reason": "A forged, legacy, stale, or incomplete pending manifest could otherwise move, publish, clean up, or mark success without enough proof that the parked payload and final destination are safe.",
  "affected_areas": [
    "contracts",
    "desktop_pending_publish",
    "metadata_coverage",
    "pending_publish",
    "publish_drain",
    "publish_repair",
    "schemas",
    "tests"
  ],
  "behavior_before": "Pending publish repair/drain paths trusted manifest fields too early, tolerated legacy manifests for auto-drain, and did not consistently enforce pending/output/source boundaries before mutation.",
  "behavior_after": "Legacy, malformed, incomplete, unsupported-state, outside-root, and missing-proof manifests remain scan-visible but cannot auto-repair, drain, publish sidecars, clean up local artifacts, or produce success evidence.",
