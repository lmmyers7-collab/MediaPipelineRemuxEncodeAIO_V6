    "config",
    "contracts",
    "local-api",
    "rename",
    "settings",
    "webview"
  ],
  "behavior_before": "Rename cleaning filters were movie-oriented, Settings exposed one filter editor, and the filename tester reported movie-only cleaner evidence. TV rename cleanup relied on hard-coded backend patterns without persisted TV filter settings.",
