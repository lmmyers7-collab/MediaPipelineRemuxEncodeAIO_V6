{
  "id": "MP-CHANGE-2026-0605-120",
  "title": "Add override encode remux fallback size guard",
  "version_target": "2026.06.05.001",
  "status": "complete",
  "type": "feature",
  "risk_level": "high",
  "date_started": "2026-06-05",
  "summary": "Add a fallback_remux size guard mode that attempts remux after an override-forced encode exceeds the configured growth buffer.",
  "reason": "When a force-encode override produces an output larger than the source growth buffer, the operator needs the pipeline to try a direct-copy remux while preserving the oversized encode if remux is blocked by media safety policy.",
  "affected_areas": [
    "contracts",
    "media_policy",
    "powershell_runtime",
    "settings",
    "tests",
    "validation",
    "webview"
  ],
  "behavior_before": "Oversized encoded outputs could warn, fail/block, or bypass the check. There was no option to reject an oversized override encode and prefer a remux result.",
  "behavior_after": "The fallback_remux size guard mode applies the existing growth buffers after encode; for folder_policy_force_encode overages it attempts remux while bypassing direct-copy bitrate caps, deletes the rejected encode only if remux publishes, and keeps the oversized encode with warning evidence when remux cannot proceed.",
