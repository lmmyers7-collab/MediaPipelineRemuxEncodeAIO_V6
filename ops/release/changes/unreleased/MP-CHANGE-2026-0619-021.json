{
  "id": "MP-CHANGE-2026-0619-021",
  "title": "Add encode GPU waste guard",
  "version_target": "2026.06.04.001",
  "status": "complete",
  "type": "behavior_change",
  "risk_level": "high",
  "date_started": "2026-06-19",
  "date_completed": "2026-06-19",
  "summary": "Added an opt-in encode GPU waste guard for fallback-remux-eligible size/bitrate encodes, including live output-size projection aborts, optional video-only preflight samples, backend config/schema metadata, and focused PowerShell/Python validation.",
  "reason": "Fallback-remux mode previously discovered oversized encodes only after the full hardware encode completed, wasting GPU time on files that would be discarded and remuxed.",
  "affected_areas": [
    "config",
    "generated",
    "media-policy",
    "tests"
  ],
  "behavior_before": "SizeGuardMode=fallback_remux inspected the completed encode output only after FFmpeg finished. Eligible automatic size/bitrate-threshold encodes could spend the full GPU encode time before being rejected and retried as remux.",
  "behavior_after": "EncodeWasteGuardMode defaults to off. When set to dry_run or enforce with SizeGuardMode=fallback_remux, eligible automatic size/bitrate-threshold hardware encodes can record projected-oversize evidence; enforce mode can abort the FFmpeg process early and reuse the existing safe remux fallback path. Forced encode overrides and CPU fallback encodes are not guarded.",
