  "date_started": "2026-07-20",
  "date_completed": "2026-07-20",
  "summary": "Add deterministic completed-unreleased packet archival with preview, strict eligibility, rollback, archive-aware release tooling, and a bounded evidence migration.",
  "reason": "Completed packets accumulated in the active unreleased directory because release finalization had never run, obscuring planned and in-progress work and retaining hundreds of derived packet summaries.",
  "affected_areas": [
    "change_control",
    "documentation",
    "generated_context",
    "maintenance",
    "release",
    "tests"
  ],
  "behavior_before": "Completed, planned, and in-progress packets shared one active directory; only full release finalization could move completed evidence, and all release readers assumed that two-location layout.",
  "behavior_after": "Validated completed packets can be previewed and moved into month-bucketed archived unreleased storage without losing release selection, validation, Maintenance discovery, rollback evidence, packet-ID searchability, or strict active worktree coverage.",
