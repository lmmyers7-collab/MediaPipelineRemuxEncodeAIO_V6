{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mediapipeline/src/mediapipeline/contracts/schemas/media_pipeline_queue_plan_snapshot.v1.schema.json",
  "title": "MediaPipeline Queue Plan Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [ "schema_version", "produced_at", "rows" ],
  "properties": {
    "schema_version": { "type": "string", "const": "queue_plan_snapshot.v1" },
    "produced_at": { "type": "string", "minLength": 1 },
    "config_path": { "type": "string" },
    "local_base": { "type": "string" },
    "source_movies": { "type": "string" },
    "source_tv": { "type": "string" },
    "outsource": { "type": "string" },
    "priority_markers": { "type": "array", "items": { "type": "string" } },
    "movie_count_total": { "type": "integer", "minimum": 0 },
    "tv_count_total": { "type": "integer", "minimum": 0 },
    "priority_count": { "type": "integer", "minimum": 0 },
    "runnable_count": { "type": "integer", "minimum": 0 },
    "total_row_count": { "type": "integer", "minimum": 0 },
    "shown_row_count": { "type": "integer", "minimum": 0 },
    "row_limit": { "type": "integer", "minimum": 0 },
    "rows_truncated": { "type": "boolean" },
    "excluded_count": { "type": "integer", "minimum": 0 },
    "excluded_row_limit": { "type": "integer", "minimum": 0 },
    "excluded_rows_truncated": { "type": "boolean" },
    "excluded_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/excludedRow" }
    },
    "accepted_run_rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptedRunRow" }
    },
    "accepted_run_rows_fingerprint_schema": {
      "type": "string",
      "const": "accepted_run_rows_fingerprint.v1"
    },
    "accepted_run_rows_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/queueRow" }
    }
  },
  "$defs": {
    "acceptedRunRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity",
        "source_identity_algorithm",
        "source_path",
        "display_name",
        "planned_display_name",
        "planned_display_name_source",
        "parent_context",
        "run_queue_index",
        "run_queue_total",
        "route",
        "route_reason_code",
        "route_reason"
      ],
      "properties": {
        "source_identity": { "type": "string", "minLength": 1 },
        "source_identity_algorithm": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "planned_display_name": { "type": "string", "minLength": 1 },
        "planned_display_name_source": { "const": "plex_destination_plan.v1" },
        "parent_context": { "type": "string" },
        "run_queue_index": { "type": "integer", "minimum": 1 },
        "run_queue_total": { "type": "integer", "minimum": 1 },
        "route": { "type": "string" },
        "route_reason_code": { "type": "string" },
        "route_reason": { "type": "string" },
        "intended_final_path": { "type": "string" }
      }
    },
    "queueRow": {
      "type": "object",
      "additionalProperties": true,
      "required": [ "source_path", "media_kind", "queue_index", "queue_total", "display_name" ],
      "properties": {
        "global_order": { "type": "integer", "minimum": 0 },
        "phase": { "type": "string" },
        "media_kind": { "type": "string" },
        "queue_index": { "type": "integer", "minimum": 0 },
        "queue_total": { "type": "integer", "minimum": 0 },
        "run_queue_index": { "type": "integer", "minimum": 0 },
        "run_queue_total": { "type": "integer", "minimum": 0 },
        "is_priority": { "type": "boolean" },
        "priority_reasons": { "type": "array", "items": { "type": "string" } },
        "priority_rank": { "type": "integer" },
        "source_path": { "type": "string", "minLength": 1 },
        "root_path": { "type": "string" },
        "relative_path": { "type": "string" },
        "display_name": { "type": "string" },
        "show_sort_key": { "type": "string" },
        "season_sort_key": { "type": "string" },
        "season_number": { "type": "integer" },
        "episode_number": { "type": "integer" },
        "size_gb": { "type": "number", "minimum": 0 },
        "last_write_utc": { "type": "string" },
        "route": { "type": "string" },
        "route_reason_code": { "type": "string" },
        "route_reason": { "type": "string" },
        "blocked_reason_code": { "type": "string" },
        "blocked_reason": { "type": "string" },
        "runtime_checks_deferred": { "type": "boolean" },
        "runtime_check_codes": { "type": "array", "items": { "type": "string" } },
        "runtime_check_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "excludedRow": {
      "type": "object",
      "additionalProperties": true,
      "required": [ "source_path", "media_kind", "display_name", "reason_code" ],
      "properties": {
        "source_order": { "type": "integer", "minimum": 0 },
        "reason_code": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "phase": { "type": "string" },
        "media_kind": { "type": "string" },
        "queue_index": { "type": "integer", "minimum": 0 },
        "queue_total": { "type": "integer", "minimum": 0 },
        "run_queue_index": { "type": "integer", "minimum": 0 },
        "run_queue_total": { "type": "integer", "minimum": 0 },
        "is_priority": { "type": "boolean" },
        "priority_reasons": { "type": "array", "items": { "type": "string" } },
        "priority_rank": { "type": "integer" },
        "source_path": { "type": "string", "minLength": 1 },
        "root_path": { "type": "string" },
        "relative_path": { "type": "string" },
        "display_name": { "type": "string" },
        "show_sort_key": { "type": "string" },
        "season_sort_key": { "type": "string" },
        "season_number": { "type": "integer" },
        "episode_number": { "type": "integer" },
        "size_gb": { "type": "number", "minimum": 0 },
        "last_write_utc": { "type": "string" }
      }
    }
  }
}
