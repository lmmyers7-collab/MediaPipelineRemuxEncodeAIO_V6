{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mediapipeline/src/mediapipeline/contracts/schemas/media_pipeline_progress.v1.schema.json",
  "title": "MediaPipeline Progress State",
  "type": "object",
  "additionalProperties": true,
  "required": [ "ProgressVersion", "LastUpdate", "Status" ],
  "properties": {
    "ProgressVersion": { "type": "integer", "minimum": 1 },
    "LastUpdate": { "type": "string" },
    "SessionStartedAt": { "type": [ "string", "null" ] },
    "CurrentFile": { "type": [ "string", "null" ] },
    "CurrentFileDisplay": { "type": [ "string", "null" ] },
    "CurrentFilePath": { "type": [ "string", "null" ] },
    "CurrentMediaType": { "type": [ "string", "null" ] },
    "CurrentLibraryId": { "type": [ "string", "null" ] },
    "CurrentLibraryName": { "type": [ "string", "null" ] },
    "CurrentLibraryDesignation": { "type": [ "string", "null" ] },
    "CurrentLibrarySourceRoot": { "type": [ "string", "null" ] },
    "CurrentLibraryOutputRoot": { "type": [ "string", "null" ] },
    "CurrentQueuePhase": { "type": [ "string", "null" ] },
    "CurrentQueueIndex": { "type": "integer", "minimum": 0 },
    "CurrentQueueTotal": { "type": "integer", "minimum": 0 },
    "CurrentRoute": { "type": [ "string", "null" ] },
    "CurrentStage": { "type": [ "string", "null" ] },
    "CurrentStagePercent": { "type": [ "number", "null" ], "minimum": 0, "maximum": 100 },
    "CurrentItemStartedAt": { "type": [ "string", "null" ] },
    "CurrentStageStartedAt": { "type": [ "string", "null" ] },
    "CopyState": { "type": [ "string", "null" ] },
    "PushState": { "type": [ "string", "null" ] },
    "SidecarState": { "type": [ "string", "null" ] },
    "CopyBytesCopied": { "type": [ "integer", "null" ], "minimum": 0 },
    "CopyTotalBytes": { "type": [ "integer", "null" ], "minimum": 0 },
    "CopyPercent": { "type": [ "number", "null" ], "minimum": 0, "maximum": 100 },
    "CopyAttempt": { "type": [ "integer", "null" ], "minimum": 1 },
    "CopySource": { "type": [ "string", "null" ] },
    "CopyDestination": { "type": [ "string", "null" ] },
    "CopyStartedAt": { "type": [ "string", "null" ] },
    "CopyUpdatedAt": { "type": [ "string", "null" ] },
    "CopySessionBytesPerSecond": { "type": [ "integer", "null" ], "minimum": 0 },
    "CopySessionFilesCompleted": { "type": "integer", "minimum": 0 },
    "PauseRequested": { "type": "boolean" },
    "StopRequested": { "type": "boolean" },
    "ControlRequests": { "type": "object", "additionalProperties": true },
    "Status": { "type": "string" },
    "TotalProcessed": { "type": "integer", "minimum": 0 },
    "Encoded": { "type": "integer", "minimum": 0 },
    "Remuxed": { "type": "integer", "minimum": 0 },
    "Failed": { "type": "integer", "minimum": 0 },
    "Movies": { "type": "integer", "minimum": 0 },
    "TVEpisodes": { "type": "integer", "minimum": 0 },
    "ConsecutiveUnexpectedRoundFailures": { "type": "integer", "minimum": 0 },
    "LastUnexpectedRoundFailureAt": { "type": [ "string", "null" ] },
    "ContinuousRoundFailuresBlocked": { "type": "boolean" },
    "ConsecutiveRoundFailureBlockLimit": { "type": "integer", "minimum": 1 },
    "ConsecutiveRoundFailureProbeBackoffSeconds": { "type": "integer", "minimum": 1 },
    "PauseFlagReviewSeconds": { "type": "integer", "minimum": 1 },
    "PauseFlagBlockSeconds": { "type": "integer", "minimum": 1 },
    "LastQueueScanDurationSeconds": { "type": [ "number", "null" ], "minimum": 0 },
    "LastQueueCandidateCount": { "type": "integer", "minimum": 0 },
    "LastQueueExecutionTruncated": { "type": "boolean" },
    "LastQueueScanTruncated": { "type": "boolean" },
    "LastQueueScanTimedOut": { "type": "boolean" }
  }
}
