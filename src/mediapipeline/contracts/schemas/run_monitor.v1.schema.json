        "job_id",
        "source_identity",
        "source_path",
        "display_name",
        "position",
        "total",
        "lifecycle_state",
        "lifecycle_evidence",
        "updated_at",
        "routes",
        "stages",
        "audio",
        "subtitles",
        "output",
        "failure",
        "recovery"
      ],
