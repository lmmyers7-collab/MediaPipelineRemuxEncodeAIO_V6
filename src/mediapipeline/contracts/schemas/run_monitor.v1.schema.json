          "title": "Fingerprint",
          "type": "string"
        },
        "accepted_count": {
          "minimum": 0,
          "title": "Accepted Count",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "fingerprint",
        "accepted_count"
      ],
      "title": "AcceptedQueueIdentity",
      "type": "object"
    },
    "AudioEvidence": {
