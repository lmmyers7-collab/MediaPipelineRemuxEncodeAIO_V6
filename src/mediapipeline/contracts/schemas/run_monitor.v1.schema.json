          "title": "State",
          "type": "string"
        },
        "started_at": {
          "default": "",
          "title": "Started At",
          "type": "string"
        },
        "updated_at": {
          "default": "",
          "title": "Updated At",
          "type": "string"
        },
        "completed_at": {
          "default": "",
          "title": "Completed At",
          "type": "string"
        },
        "output_codec": {
          "default": "",
          "title": "Output Codec",
          "type": "string"
        },
        "output_channels": {
          "default": 0,
          "minimum": 0,
