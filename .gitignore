# Python/cache artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Local/private generated state and validation output
/LocalBase/
/CodexVerification/

# Bundled runtimes/tools; keep out of source history unless intentionally packaging them
/apps/desktop/runtime/
/ops/pipeline/runtime/
/ops/pipeline/tools/

# Tauri/WebView2 shell build artifacts
node_modules/
apps/desktop/tauri/node_modules/
apps/desktop/tauri/src-tauri/target/
apps/desktop/tauri/src-tauri/gen/

# Desktop app runtime output
apps/desktop/*.log
apps/desktop/*.state.json
apps/desktop/encode_speed_history.json
apps/desktop/runlogs/
src/*.log
src/mediapipeline/desktop/*.log
src/mediapipeline/desktop/*.state.json

# Python packaging metadata from editable installs
src/*.egg-info/

# Root/local API captures from smoke checks and assistant validation runs
/RunLogs/
/*.log
/*.out.log
/*.err.log
/*.stdout.log
/*.stderr.log
/*.jsonl
/_codex_*.log
/_codex_*.out.log
/_codex_*.err.log
/local_api_*.log

# Local assistant/editor settings
.claude/settings.local.json
docs/archive/root-artifacts/

# Pipeline runtime output/state
ops/pipeline/*.log
ops/pipeline/*.tmp
ops/pipeline/*.bak
ops/pipeline/*_progress.json
ops/pipeline/pipeline_progress.json
ops/pipeline/audit_progress.json
ops/pipeline/.single_instance*
ops/pipeline/config/MediaPipeline_config.psd1
ops/pipeline/config/MediaPipeline_config.backup_*.psd1
# Legacy operator config name (pre-V7 rename); kept until migration is complete.
ops/pipeline/config/MediaPipeline_config_chatgpt.psd1
ops/pipeline/config/MediaPipeline_config_chatgpt.backup_*.psd1
ops/pipeline/config/backups/

# Local media-processing workspaces if created inside the bundle
ops/pipeline/Incoming/
ops/pipeline/Processing/
ops/pipeline/Encoded/
ops/pipeline/Failed/
ops/pipeline/AuditReports/
ops/pipeline/PendingServerPush/
ops/pipeline/Completed/
ops/pipeline/RemuxTemp/
ops/pipeline/Scratch/
ops/pipeline/.mediapipeline-staging/

# Generated reports/cache directories
**/AuditReports/
**/ProbeCache/
**/RunLogs/
**/Failed/Reports/
**/Failed/Artifacts/
**/Failed/Markers/

# OS/editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo

# Accidental terminal captures
vlc-help.txt
*-help.txt
*.console.txt

# Editor / assistant worktrees nested inside the bundle
.claude/worktrees/
.codex-remote-attachments/

# Generated deployable/release copies if built inside the workspace
*_Deployable*/
*_Release*/
*.release.zip

# Operator validation logs and real-media validation worksheets
# These files contain personal machine paths (source_path, output_path, operator notes).
# The release builder excludes LocalBase\State\ by default, but no prior .gitignore entry
# covered these specifically. Do not commit them to shared or public repositories.
**/State/Validation/sample_validation_log.jsonl
docs/RealMediaValidationRuns/*.md
!docs/RealMediaValidationRuns/README.md
docs/PG3CleanMachineReports/
