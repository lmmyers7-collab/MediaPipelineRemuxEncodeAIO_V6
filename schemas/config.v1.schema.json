      "const": 1,
      "default": 1,
      "title": "Configschemaversion",
      "type": "integer"
    },
    "SourceMovies": {
      "default": "C:\\MediaPipeline\\Incoming\\Movies",
      "minLength": 1,
      "title": "Sourcemovies",
      "type": "string"
    },
    "SourceTV": {
      "default": "C:\\MediaPipeline\\Incoming\\TV",
      "minLength": 1,
      "title": "Sourcetv",
      "type": "string"
    },
    "Outsource": {
      "default": "C:\\MediaPipeline\\Processed",
      "minLength": 1,
      "title": "Outsource",
      "type": "string"
    },
    "LibraryProfiles": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Libraryprofiles",
      "type": "array"
    },
    "LocalBase": {
      "default": "C:\\MediaPipeline\\Scratch",
      "minLength": 1,
      "title": "Localbase",
      "type": "string"
    },
