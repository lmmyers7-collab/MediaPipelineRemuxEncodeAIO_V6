    "StripFormatting": {
      "default": true,
      "title": "Stripformatting",
      "type": "boolean"
    },
    "RemoveKaraoke": {
      "default": true,
      "title": "Removekaraoke",
      "type": "boolean"
    },
    "MergeAdjacent": {
      "default": true,
      "title": "Mergeadjacent",
      "type": "boolean"
    },
    "MergeThresholdMs": {
      "default": 150,
      "minimum": 0,
      "title": "Mergethresholdms",
      "type": "integer"
    },
    "KeepSignsAndSongs": {
      "default": true,
      "title": "Keepsignsandsongs",
      "type": "boolean"
    },
    "TreatAssSignsSongsAsForced": {
      "default": false,
      "title": "Treatasssignssongsasforced",
      "type": "boolean"
    },
    "TreatTx3gSignsSongsAsForced": {
      "default": false,
      "title": "Treattx3Gsignssongsasforced",
      "type": "boolean"
    },
    "TreatBdpgsSignsSongsAsForced": {
      "default": false,
      "title": "Treatbdpgssignssongsasforced",
      "type": "boolean"
    },
    "ExcludeSubtitleStyles": {
      "items": {
        "type": "string"
      },
      "title": "Excludesubtitlestyles",
      "type": "array"
    },
    "IncludeSubtitleStyles": {
      "items": {
        "type": "string"
      },
      "title": "Includesubtitlestyles",
      "type": "array"
    },
    "RemuxSafeVideoCodecs": {
      "items": {
        "type": "string"
      },
      "title": "Remuxsafevideocodecs",
      "type": "array"
    },
    "ValidExtensions": {
      "items": {
        "type": "string"
      },
      "title": "Validextensions",
      "type": "array"
    },
    "FileStabilityWait": {
      "default": 15,
      "minimum": 0,
      "title": "Filestabilitywait",
      "type": "integer"
    },
    "SkipStabilityCheck": {
      "default": false,
      "title": "Skipstabilitycheck",
      "type": "boolean"
    },
    "EnableIntegrityCheck": {
      "default": true,
      "title": "Enableintegritycheck",
      "type": "boolean"
    },
    "CreateTVSubfolder": {
      "default": true,
      "title": "Createtvsubfolder",
      "type": "boolean"
    },
    "AggressiveEpisodeParsing": {
      "default": false,
      "title": "Aggressiveepisodeparsing",
      "type": "boolean"
