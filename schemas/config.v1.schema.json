      "type": "integer"
    },
    "TVEncodeThresholdGB": {
      "default": 3,
      "minimum": 1,
      "title": "Tvencodethresholdgb",
      "type": "integer"
    },
    "RoutingProfile": {
      "default": "plex_direct_stream",
