      "default": "hevc_nvenc",
      "minLength": 1,
      "title": "Videocodec",
      "type": "string"
    },
    "VideoPreset": {
      "default": "p7",
      "minLength": 1,
      "title": "Videopreset",
      "type": "string"
    },
    "VideoQuality": {
      "default": 22,
      "minimum": 0,
      "title": "Videoquality",
      "type": "integer"
    },
    "OutputContainer": {
      "default": "mkv",
      "enum": [
        "mkv",
        "mp4"
      ],
      "title": "Outputcontainer",
      "type": "string"
    },
