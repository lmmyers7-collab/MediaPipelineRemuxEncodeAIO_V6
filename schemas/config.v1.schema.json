    "CpuEncodePreset": {
      "default": "medium",
      "enum": [
        "ultrafast",
        "superfast",
        "veryfast",
        "faster",
        "fast",
        "medium",
        "slow",
        "slower",
        "veryslow",
        "placebo"
      ],
      "title": "Cpuencodepreset",
      "type": "string"
    },
    "CpuEncodeProcessPriority": {
      "default": "belownormal",
      "enum": [
        "inherit",
        "idle",
        "belownormal",
        "normal",
        "abovenormal",
        "high"
      ],
      "title": "Cpuencodeprocesspriority",
      "type": "string"
    },
    "CpuEncodeMaxThreads": {
      "default": 0,
      "maximum": 256,
      "minimum": 0,
      "title": "Cpuencodemaxthreads",
      "type": "integer"
