      "default": "balanced_nvenc",
      "enum": [
        "balanced_nvenc",
        "quality_nvenc",
        "fast_nvenc",
        "compatibility",
        "custom_legacy_flags"
      ],
      "title": "Encodetuningpreset",
      "type": "string"
    },
    "EncodeLadder": {
      "default": "auto",
      "enum": [
        "auto",
        "tv_balanced",
        "tv_space_saver",
        "movie_balanced",
        "movie_archive",
        "plex_compat"
      ],
      "title": "Encodeladder",
      "type": "string"
    },
    "ExtraVideoFlags": {
      "items": {
        "type": "string"
      },
      "title": "Extravideoflags",
      "type": "array"
    },
    "AudioPassthroughProfile": {
      "default": "plex_balanced",
      "enum": [
        "plex_balanced",
        "compatibility",
        "lossless_passthrough",
        "custom_codec_list"
      ],
      "title": "Audiopassthroughprofile",
      "type": "string"
    },
    "CompatibleAudioCodecs": {
      "items": {
        "type": "string"
      },
      "title": "Compatibleaudiocodecs",
      "type": "array"
    },
    "PreferredDefaultAudioLanguages": {
      "items": {
        "type": "string"
      },
      "title": "Preferreddefaultaudiolanguages",
      "type": "array"
    },
    "AudioTranscodeCodec": {
      "default": "eac3",
      "enum": [
        "eac3",
        "ac3",
        "aac"
      ],
      "title": "Audiotranscodecodec",
      "type": "string"
    },
    "AudioTranscodeBitrate": {
      "default": "640k",
      "pattern": "^\\d+k$",
      "title": "Audiotranscodebitrate",
      "type": "string"
    },
    "AudioTranscodeAutoBitrateByChannels": {
      "default": false,
      "title": "Audiotranscodeautobitratebychannels",
      "type": "boolean"
    },
    "AudioDownmixMode": {
      "default": "max_channels",
      "enum": [
        "preserve",
        "max_channels",
        "stereo"
      ],
      "title": "Audiodownmixmode",
      "type": "string"
    },
    "AudioMaxChannels": {
      "default": 6,
      "maximum": 16,
      "minimum": 1,
      "title": "Audiomaxchannels",
      "type": "integer"
    },
    "AllowNoAudio": {
      "default": false,
      "title": "Allownoaudio",
      "type": "boolean"
    },
    "SubKeepLanguages": {
      "items": {
        "type": "string"
      },
      "title": "Subkeeplanguages",
      "type": "array"
    },
    "ConvertTx3gToSrt": {
      "default": true,
      "title": "Converttx3Gtosrt",
      "type": "boolean"
    },
    "DropTx3gAfterConversion": {
      "default": false,
      "title": "Droptx3Gafterconversion",
      "type": "boolean"
    },
    "CreateExternalTx3gSrtSidecars": {
      "default": false,
      "title": "Createexternaltx3Gsrtsidecars",
      "type": "boolean"
    },
    "Tx3gExtractLanguages": {
      "items": {
        "type": "string"
      },
      "title": "Tx3Gextractlanguages",
      "type": "array"
    },
    "Tx3gPreserveExistingSrt": {
      "default": true,
      "title": "Tx3Gpreserveexistingsrt",
      "type": "boolean"
    },
    "Tx3gTreatForcedAsSeparate": {
      "default": true,
      "title": "Tx3Gtreatforcedasseparate",
      "type": "boolean"
    },
    "ConvertBdpgsToSrt": {
      "default": false,
      "title": "Convertbdpgstosrt",
      "type": "boolean"
    },
    "DropBdpgsAfterConversion": {
      "default": false,
      "title": "Dropbdpgsafterconversion",
      "type": "boolean"
    },
    "BdpgsExtractLanguages": {
      "items": {
        "type": "string"
      },
      "title": "Bdpgsextractlanguages",
      "type": "array"
    },
    "BdpgsOcrToolPath": {
      "default": "Tools\\PgsToSrt\\PgsToSrt.exe",
      "title": "Bdpgsocrtoolpath",
      "type": "string"
