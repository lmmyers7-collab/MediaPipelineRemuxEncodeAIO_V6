    "CompatibilityEncodeGrowthPercent": {
      "default": 15,
      "maximum": 1000,
      "minimum": 0,
      "title": "Compatibilityencodegrowthpercent",
      "type": "number"
    },
    "MinFreeSpaceGB": {
      "default": 50,
      "minimum": 0,
      "title": "Minfreespacegb",
      "type": "integer"
    },
    "OutsourceMinFreeSpaceGB": {
      "default": 50,
      "minimum": 0,
      "title": "Outsourceminfreespacegb",
      "type": "integer"
    },
    "DeferredPublish": {
      "default": false,
      "title": "Deferredpublish",
      "type": "boolean"
    },
    "FinalLibraryPromotionEnabled": {
      "default": false,
      "title": "Finallibrarypromotionenabled",
      "type": "boolean"
    },
    "FinalLibraryPromotionRules": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Finallibrarypromotionrules",
      "type": "array"
    },
