    "SourceScanTimeoutSeconds": {
      "default": 1800,
      "minimum": 1,
      "title": "Sourcescantimeoutseconds",
      "type": "integer"
    },
    "CleanupScanTimeoutSeconds": {
      "default": 300,
      "minimum": 1,
      "title": "Cleanupscantimeoutseconds",
      "type": "integer"
    },
    "CleanupRemoteStaging": {
      "default": false,
      "title": "Cleanupremotestaging",
