    "H264RemuxMaxHeight": {
      "default": 1080,
      "maximum": 4320,
      "minimum": 1,
      "title": "H264Remuxmaxheight",
      "type": "integer"
    },
    "SizeGuardMode": {
      "default": "advisory",
      "enum": [
        "advisory",
        "strict",
        "off"
      ],
      "title": "Sizeguardmode",
      "type": "string"
