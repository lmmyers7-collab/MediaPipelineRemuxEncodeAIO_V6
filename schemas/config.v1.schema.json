    "QueueOrderingStrategy": {
      "default": "Standard",
      "enum": [
        "Standard",
        "FreshestFirst",
        "ShowComplete",
        "RoundRobin",
        "DeadlineAware",
        "SmallFirst",
        "LargeFirst",
        "ManualOrder"
      ],
      "title": "Queueorderingstrategy",
      "type": "string"
