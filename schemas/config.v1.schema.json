    "FinalLibraryPromotionEnabled": {
      "default": false,
      "title": "Finallibrarypromotionenabled",
      "type": "boolean"
    },
    "FinalLibraryPromotionRules": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
