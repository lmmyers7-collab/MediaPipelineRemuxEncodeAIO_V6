      "default": "cautious",
      "enum": [
        "fast",
        "cautious"
      ],
      "title": "Finallibrarypromotionverificationmode",
      "type": "string"
    },
    "FinalLibraryPromotionCleanupAfterVerified": {
      "default": false,
      "title": "Finallibrarypromotioncleanupafterverified",
      "type": "boolean"
    },
    "FinalLibraryPromotionOverwriteExisting": {
      "default": false,
      "title": "Finallibrarypromotionoverwriteexisting",
      "type": "boolean"
    },
