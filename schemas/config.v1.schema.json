      "default": 3,
      "minimum": 1,
      "title": "Tvencodethresholdgb",
      "type": "integer"
    },
    "RoutingProfile": {
      "default": "plex_direct_stream",
      "enum": [
        "plex_direct_stream",
        "plex_direct_play",
        "archive_shrink",
        "archive_quality",
        "manual"
      ],
      "title": "Routingprofile",
      "type": "string"
